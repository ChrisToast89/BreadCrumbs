# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
dist-electron/
out/
release/
# NOTE: `build/` is NOT ignored. electron-builder uses it for build
# *resources* — the icon source art — which is a tracked input, not output.
# Our actual outputs are out/ and release/, both ignored above.
*.tsbuildinfo

# electron-builder
.electron-builder-cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime / cache
.cache/
.temp/
.tmp/
.vite/
.eslintcache

# Environment
.env
.env.*
!.env.example

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db
desktop.ini

# BreadCrumbs working data
# Real-world clips, supplied locally. Never committed.
samples/

# Test media is large and supplied locally; keep the folder, not its contents.
fixtures/*
!fixtures/.gitkeep
!fixtures/README.md
# Generated proxies, thumbnail caches, analysis output, exports
projects/
scratch/
inspect-out/
